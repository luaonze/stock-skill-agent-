# 默认模型配置
AGENT_MODEL=gpt-5.4
AGENT_ROUTER_MODEL=

# 模型调用模式：
# responses = OpenAI Responses API
# chat = Chat Completions API，适合 MiMo 或部分 OpenAI 兼容中转站
AGENT_LLM_MODE=responses

# 技能目录。相对路径默认相对项目根目录。
AGENT_SKILLS_DIR=skills

# 推荐方式：用 AGENT_API_KEY / AGENT_BASE_URL 作为当前启用配置。
AGENT_API_KEY=your-api-key
AGENT_BASE_URL=https://api.openai.com/v1

# 如果 .env 里同时放了多套 Key，可以用下面两个变量指定读取哪一套。
# AGENT_API_KEY_ENV=OPENAI_API_KEY_1
# AGENT_BASE_URL_ENV=OPENAI_BASE_URL_1

# Chat Completions 模式参数
AGENT_MAX_COMPLETION_TOKENS=2048
AGENT_TEMPERATURE=1.0
AGENT_TOP_P=0.95

# Tushare 数据技能配置
# 注册地址：https://tushare.pro/register
TUSHARE_TOKEN=your-tushare-token
